# AgentPlane environment configuration template.
# Copy to .env and fill in real values. .env is git-ignored.

# --- Required ---

# PostgreSQL connection string for users + API keys. Migrations are applied
# automatically on startup (see migrations/).
DATABASE_URL=postgres://agentplane:agentplane@localhost:5432/agentplane?sslmode=disable

# Server-side pepper mixed into API-key hashes (SHA-256(secret + pepper)).
# Must be a secret; changing it invalidates every existing API key.
API_KEY_PEPPER=dev-pepper-change-me

# Token authorizing admin endpoints (/provision/user, /admin/api-keys/revoke).
# Sent as: Authorization: Bearer <token>
AGENTPLANE_ADMIN_TOKEN=dev-admin-token-change-me

# --- Provider ---

# OpenAI-compatible API key. Loaded via the secret store below.
OPENAI_API_KEY=sk-xxxxxxxx

# Override the upstream API base URL (default: https://api.openai.com/v1).
OPENAI_BASE_URL=https://api.openai.com/v1

# --- Secret store ---
# Where secrets (OPENAI_API_KEY, API_KEY_PEPPER) are read from.
#   env    -> environment variables (default for local dev)
#   file   -> files under SECRET_STORE_PATH
#   vault  -> HashiCorp Vault (default when unset)
#   aws    -> AWS Secrets Manager
#   azure  -> Azure Key Vault
#   chain  -> try SECRET_STORE_PATH files, then environment
SECRET_STORE=env

# SECRET_STORE=file / chain:
SECRET_STORE_PATH=/run/secrets

# SECRET_STORE=vault:
VAULT_ADDR=http://127.0.0.1:8200
VAULT_TOKEN=
VAULT_MOUNT_PATH=agentplane
# VAULT_KV_VERSION=2
# AppRole fallback when VAULT_TOKEN is unset:
# VAULT_ROLE_ID=
# VAULT_SECRET_ID=

# SECRET_STORE=aws:
# AWS_REGION=
# AWS_ENDPOINT_URL=
# AWS_SECRET_ID=
# AWS_SECRET_JSON_KEY=

# SECRET_STORE=azure:
# AZURE_KEY_VAULT_URL=

# --- Server ---
PORT=3001
